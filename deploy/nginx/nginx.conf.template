worker_processes auto;
events { worker_connections 1024; }
http {
  map $http_upgrade $connection_upgrade { default upgrade; '' close; }
  server { listen 80; server_name ${APP_BASE_URL_HOST}; return 308 https://$host$request_uri; }
  server {
    listen 443 ssl;
    server_name ${APP_BASE_URL_HOST};
    ssl_certificate ${TLS_CERTIFICATE_PATH};
    ssl_certificate_key ${TLS_PRIVATE_KEY_PATH};
    client_max_body_size 6m;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    location = /actuator/health/liveness { proxy_pass http://app:${SERVER_PORT}; proxy_set_header X-Forwarded-Proto https; proxy_set_header X-Forwarded-Host $host; }
    location = /actuator/health/readiness { proxy_pass http://app:${SERVER_PORT}; proxy_set_header X-Forwarded-Proto https; proxy_set_header X-Forwarded-Host $host; }
    location / {
      proxy_pass http://app:${SERVER_PORT};
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Host $host;
    }
  }
}
